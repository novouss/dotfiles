{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
        
  "modules-left": ["custom/weather"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["group/expand", "group/tools", "clock"],

  "custom/weather": {
    "format": "{text}",
    "tooltip": false,
    "interval": 6000,
    "exec": "python3 /home/ray_linux/dotfiles/.config/waybar/scripts/get-weather.py",
    "return-type": "string"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": " ",
      "default": " ",
      "empty": " "
    },
    "persistent-workspaces": {
      "*": [ 1,2,3,4,5 ]
    }
  },

  "custom/expand": {
    "format": " ",
    "tooltip": false
  },

  "group/expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-to-left": true,
      "click-to-reveal": true
    },
    "modules": ["custom/expand", "tray"]
  },
  
  "network": {
    "format": "{icon}",
    "format-icons": {
      "wifi": ["󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
      "ethernet": ["󰖟 "],
      "disconnected": ["󰤭 "]
    },
    "tooltip": false
  },

  "group/tools": {
    "orientation": "horizontal",
    "modules": ["network", "group/audio"]
  },

  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio#mic", "pulseaudio#audio"]
  },

  "pulseaudio#mic": {
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "format": "{format_source}",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "tooltip": false
  },

  "pulseaudio#audio": {
    "format": "󰕾",
    "format-muted": "󰝟",
    "tooltip": false,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "clock": {
    "locale": "en_US.UTF-8",
    "format": "{:%a %e - %I:%M %p}",
    "interval": 60,
    "tooltip-format": "<span size='9pt'>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#F38BA8'><b>{}</b></span>",
        "days": "<span color='#C6D0F5'><b>{}</b></span>",
        "weekdays": "<span color='#C6D0F5'><i>{}</i></span>",
        "today": "<span color='#E5C890'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click": "shift_down",
      "on-click-right": "shift_up"
    }
  }
}
